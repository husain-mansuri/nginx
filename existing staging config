{% if subdomain == 'fit' %}
server {
    server_name {{ subdomain }}-{{ instance_name }}.practodev.com;
    listen 443 ssl;

    {% if fit_web %}
    set $upstream_fit_web http://{{ fit_web }};
    {% endif %}
    {% if fit_api %}
    set $upstream_fit_api http://{{ fit_api }};
    {% endif %}

    {% if fit_web %}
    location @ui {
        include proxy_params;
        proxy_pass $upstream_fit_web;
    }

    location / {
        try_files $uri @ui;
    }
    {% endif %}

    {% if fit_api %}
    location /api/ {
        try_files $uri @api;
    }

    location @api {
        rewrite ^/api/(.*)$ /$1 break;
        include proxy_params;
        proxy_pass $upstream_fit_api;
    }
    {% endif %}
}
{% elif subdomain == 'dooku' %}
server {
    server_name {{ subdomain }}-{{ instance_name }}.practodev.com;
    listen 443 ssl;

    {% if dooku_ui %}
    set $upstream_dooku_ui http://{{ dooku_ui }};
    {% endif %}
    {% if dooku_api %}
    set $upstream_dooku_api http://{{ dooku_api }};
    {% endif %}

    {% if dooku_ui %}
    location @ui {
        include proxy_params;
        proxy_pass $upstream_dooku_ui;
    }

    location / {
        try_files $uri @ui;
    }
    {% endif %}

    {% if dooku_api %}
