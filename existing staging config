    # Clinic and Hospital Profile URL & establishment speciality page URL
    # 
    # OVERVIEW: This location handles establishment profile pages for both consumer_ui and topaz flows.
    #
    # CONSUMER UI FLOW (SSG with S3 fallback to SSR):
    # - For consumer_ui with Sapphire: Rewrites to named location @__s3_establishment_profile
    #   - Named location proxies to S3 for pre-generated static HTML files
    #   - Uses named location to avoid nginx if-block limitations for proxy_set_header Host
    #   - On S3 404 (file not generated yet, or generation failed): Falls back to Next.js SSR via @establishment_profile_fallback
    #   - Sets SERVED-FROM header indicating S3(SSG) or NEXT(SSR)
    #   - Sets S3-URL header with the S3 URL that was attempted
    #
    # TOPAZ FLOW (direct proxy):
    # - For topaz: Direct proxy to topaz upstream
    # - On 404: Returns 404 directly to client (does NOT fallback to consumer_ui)
    # - No error_page set, so fallback location is never called
    #
    # NAMED LOCATIONS:
    # - @__s3_establishment_profile: Proxies requests to S3 with proper Host header for virtual-hosted bucket routing
    #   - Only called from consumer_ui flow via rewrite with 'last' flag
    #   - Sets error_page 404 to @establishment_profile_fallback
    # - @establishment_profile_fallback: Handles S3 404s, routes to Next.js SSR
    #   - Only called from consumer_ui S3 flow (topaz never reaches this)
    #
    # HEADERS:
    # - Add SERVED-FROM and S3-URL for debugging and monitoring
    # - These apply to all requests when consumer_ui is enabled (may have empty values for topaz)
    #
    location ~* ^/([^/]+)/(clinic|hospital)/([^/]+)(/[^/]+)?$ {
      include proxy_params;

      {% if consumer_ui %}
      # Extract variables from URL regex captures: city ($1), type ($2), slug ($3)
      # $4 is optional path (ignored for S3 paths)
      set $consumer_ui_city $1;
      set $consumer_ui_profile_type $2;
      set $consumer_ui_slug $3;

      # S3 configuration (LocalStack for staging, AWS S3 for production)
      # Production AWS config (commented):
      # set $consumer_ui_s3_bucket "practo-dev-mumbai-static-apps";
      # set $consumer_ui_s3_endpoint "s3.ap-south-1.amazonaws.com";
      # Staging LocalStack config:
      set $consumer_ui_s3_bucket "localstack-bucket";
      set $consumer_ui_s3_endpoint "localhost:4566";
      set $consumer_ui_s3_folder_name "consumer-ui/export-assets";
      
      # Build S3 URL and track source
      set $consumer_ui_s3_url "http://$consumer_ui_s3_endpoint/$consumer_ui_s3_bucket/$consumer_ui_s3_folder_name/$consumer_ui_city/$consumer_ui_profile_type/$consumer_ui_slug.html";
      set $consumer_ui_served_from "AWS(SSG)";
      
      # For Sapphire requests, rewrite to named location for S3 proxy
      # Using 'last' flag to exit this location block and jump to @__s3_establishment_profile
      # Named location approach avoids nginx if-block limitations for proxy_set_header Host
      # Variables set above persist and are accessible in the named location
      if ($fabric_is_sapphire = 1) {
        rewrite ^ __s3_establishment_profile last;
      }
      {% endif %}
      
      # Proxy to topaz for non-Sapphire requests
      {% if topaz %}
      if ($fabric_is_sapphire = 0) {
        proxy_pass $upstream_topaz;
      }
      {% endif %}
    }

    # Named location for S3 proxy - avoids if-block limitations
    # Called via rewrite with 'last' flag from main location block
    # All variables set in the calling location block are accessible here
    # This allows proxy_set_header Host to work reliably (not in an if-block context)
    location @__s3_establishment_profile {
      internal;
      
      # Set Host header for S3 virtual-hosted bucket routing
      # Must be set to bucket name for virtual-hosted bucket requests
      proxy_set_header Host $consumer_ui_s3_bucket;
      proxy_set_header X-Real-IP $remote_addr;
      include proxy_params;
      
      # Rewrite to S3 path with .html extension
      # Using 'break' flag to stop rewrite processing and continue with proxy_pass
      rewrite ^ /$consumer_ui_s3_folder_name/$consumer_ui_city/$consumer_ui_profile_type/$consumer_ui_slug.html break;
      
      # Error handling for S3 404s
      proxy_intercept_errors on;
      error_page 404 = @establishment_profile_fallback;
      
      # Proxy to S3 endpoint
      proxy_pass http://$consumer_ui_s3_endpoint;
      
      # Add headers to track S3-served content
      add_header SERVED-FROM $consumer_ui_served_from always;
      add_header S3-URL $consumer_ui_s3_url always;
    }

    # Fallback location for establishment profile 404s from S3
    # Only called from consumer_ui flow when S3 returns 404 (file not found)
    # The named location @__s3_establishment_profile sets error_page 404 to this fallback
    # Topaz flow never calls this - it directly proxies and returns 404s to client
    location @establishment_profile_fallback {
      internal;
      
      {% if consumer_ui %}
      # Consumer UI: Fallback to Next.js SSR when S3 returns 404
      # This handles cases where static files haven't been generated yet or generation failed
      if ($fabric_is_sapphire = 1) {
        set $consumer_ui_served_from "NEXT(SSR)";
        proxy_pass $upstream_consumer_ui;
        
        # Add headers to indicate source is Next.js SSR
        add_header SERVED-FROM $consumer_ui_served_from always;
        add_header S3-URL $consumer_ui_s3_url always;
      }
      {% endif %}
    }

