{% elif subdomain == 'abdm' %}
server {
    server_name {{ subdomain }}-{{ instance_name }}.practodev.com;
    listen 443 ssl;
    set $upstream_abdm_abha http://{{ abdm_abha }};
    set $upstream_abdm_hrp http://{{ abdm_hrp }};
